+package com.reactnativecommunity.webview
+
+import android.view.View
+import com.facebook.react.uimanager.ThemedReactContext
+import kotlin.math.max
+
+/**
+ * Spike: tell Chromium the window is still VISIBLE after Home, and refuse a
+ * 0×0 layout so the media pipeline is not given an empty surface.
+ *
+ * Gated by [forceWindowVisible] (solo playback session only).
+ */
+class AlwaysVisibleRNCWebView(reactContext: ThemedReactContext) : RNCWebView(reactContext) {
+  var forceWindowVisible: Boolean = false
+    set(value) {
+      field = value
+      if (value) {
+        super.onWindowVisibilityChanged(VISIBLE)
+        (parent as? View)?.let { p ->
+          p.clipToOutline = false
+        }
+      }
+    }
+
+  private var lastW = 0
+  private var lastH = 0
+
+  override fun onWindowVisibilityChanged(visibility: Int) {
+    super.onWindowVisibilityChanged(if (forceWindowVisible) VISIBLE else visibility)
+  }
+
+  override fun dispatchWindowVisibilityChanged(visibility: Int) {
+    super.dispatchWindowVisibilityChanged(if (forceWindowVisible) VISIBLE else visibility)
+  }
+
+  override fun onVisibilityChanged(changedView: View, visibility: Int) {
+    super.onVisibilityChanged(
+      changedView,
+      if (forceWindowVisible) VISIBLE else visibility,
+    )
+  }
+
+  override fun onSizeChanged(w: Int, h: Int, ow: Int, oh: Int) {
+    if (w > 0 && h > 0) {
+      lastW = w
+      lastH = h
+    }
+    val useW = if (forceWindowVisible) max(w, lastW) else w
+    val useH = if (forceWindowVisible) max(h, lastH) else h
+    super.onSizeChanged(useW, useH, ow, oh)
+  }
+}
