{
  "expo": {
    "name": "Bearoom",
    "slug": "bearoom",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bearoom",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#100D0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scriptingbear.bearoom"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#100D0A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.scriptingbear.bearoom"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/bearoom-playback/app.plugin.js",
      "./plugins/with-fmt-xcode-fix.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#100D0A"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "2f1092b4-e5f1-4c69-b021-95be2294813f"
      }
    }
  }
}
