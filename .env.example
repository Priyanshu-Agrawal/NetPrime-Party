# ---------------------------------------------------------------------------
# Bearoom Environment Configuration
# Copy this file to .env.local (gitignored) for local development & deployment.
# All EXPO_PUBLIC_* variables are automatically bundled into Web and Native builds.
# ---------------------------------------------------------------------------

# Supabase Watch Party & Realtime backend
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# TMDB Proxy (Cloudflare Worker that handles TMDB rate limits and server-side token injection)
EXPO_PUBLIC_TMDB_PROXY_URL=""

# KLIPY GIF/sticker key — get a free one at https://klipy.com/developers
EXPO_PUBLIC_KLIPY_KEY=your_klipy_app_key_here
